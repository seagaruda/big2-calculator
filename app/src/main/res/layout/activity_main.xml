<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Current Round -->
        <TextView
            android:id="@+id/tvCurrentRound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="第 0 局"
            android:textSize="20sp"
            android:textColor="#000000"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Player Scores Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前排名"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/llPlayerScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Add Round Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="添加新局"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输入各玩家本局结束时的剩余牌数（0-13，0 表示已出完获胜）："
            android:textSize="14sp"
            android:textColor="#000000"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/etCardsP1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="玩家1 剩余牌数"
            android:inputType="number"
            android:maxLength="2"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/etCardsP2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="玩家2 剩余牌数"
            android:inputType="number"
            android:maxLength="2"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/etCardsP3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="玩家3 剩余牌数"
            android:inputType="number"
            android:maxLength="2"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/etCardsP4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="玩家4 剩余牌数"
            android:inputType="number"
            android:maxLength="2"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnAddRound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="记录这一局"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Round History Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="历史记录"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/llRoundHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- New Game Button -->
        <Button
            android:id="@+id/btnNewGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开始新游戏"
            android:textSize="16sp"
            android:backgroundTint="#FF5722" />

    </LinearLayout>
</ScrollView>